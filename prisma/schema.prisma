// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  // The app runs through Neon's pooler: a web server opens and closes
  // connections all day, and the pooler is what keeps the database from
  // running out of them.
  url       = env("DATABASE_URL")
  // Migrations cannot go through the pooler - they need advisory locks
  // and DDL that PgBouncer does not pass through. So they take the
  // direct endpoint instead.
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ============================================================================
//  ZakTracking models
//
//  Paste this whole block at the very BOTTOM of prisma/schema.prisma.
//  Leave the Session model and the datasource/generator above it alone.
//
//  Then run:   npx prisma migrate dev --name zaktracking
// ============================================================================


/// One row per merchant store. All settings and API keys live here.
model Shop {
  id          String   @id @default(cuid())
  domain      String   @unique
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- WhatsApp (Meta Cloud API) ---
  waEnabled       Boolean @default(false)
  waPhoneNumberId String?
  waWabaId        String?
  waToken         String?

  // --- SMS (Fast2SMS - the OTP route needs no DLT registration) ---
  smsEnabled  Boolean @default(false)
  smsApiKey   String?
  smsSenderId String?
  /// "otp" = the cheap service route, does not reach DND numbers.
  /// "q"   = Quick SMS, reaches DND too, around five rupees a message.
  smsRoute    String?
  /// Which way a one-time code travels: whatsapp | sms | both.
  /// "both" tries WhatsApp first and falls back to SMS.
  otpChannel  String?

  // --- courier tracking (17TRACK) ---
  trackApiKey String?

  // --- which messages are turned on ---
  onOrderCreate    Boolean @default(true)
  onOrderPaid      Boolean @default(true)
  onFulfilled      Boolean @default(true)
  /// Off by default. It fires once per order, on the first in-transit scan,
  /// which on a short route lands moments after the shipped message.
  onInTransit      Boolean @default(false)
  onOutForDelivery Boolean @default(true)
  onDelivered      Boolean @default(true)
  onCancelled      Boolean @default(true)
  onAbandoned      Boolean @default(false)
  /// The whole Cash-on-Delivery conversation: the ask, the reminder, the
  /// confirmation. Off, and a COD order is treated like any other order.
  codConfirm       Boolean @default(true)
  /// Each of its three messages on its own switch besides.
  onCodConfirm     Boolean @default(true)
  onCodReminder    Boolean @default(true)
  onCodConfirmed   Boolean @default(true)
  /// Hours of silence after the ask before the reminder goes out.
  codReminderHours Int     @default(6)
  /// With still no reply this many minutes after the reminder, the order
  /// is taken as confirmed and packed - a customer who wanted it cancelled
  /// had two chances to say so, and most who stay silent do want it.
  autoConfirm      Boolean @default(true)
  autoConfirmMin   Int     @default(30)

  // --- the merchant's own WhatsApp ---
  /// Where customer replies are forwarded, as a template message. Empty,
  /// and they are only kept in the inbox on the admin page.
  ownerPhone  String?
  ownerAlerts Boolean @default(true)

  orders    OrderRecord[]
  templates Template[]
  messages  MessageLog[]
  carts     AbandonedCart[]
  inbound   InboundMessage[]
  otps      OtpCode[]

  /// Name of the Meta "Authentication" template that carries the code.
  /// Left empty, the app uses zakdor_otp.
  otpTemplate String?

  /// The store's own order form at /apps/track/buy. Off until the merchant
  /// has tested it - it writes real orders.
  formEnabled Boolean @default(false)
  /// How much cheaper paying online is, in rupees. Shown on the form and
  /// applied by the discount code below at Shopify's checkout.
  prepaidOff  String?
  /// The Shopify discount code that takes that amount off.
  prepaidCode String?

  /// When the customer presses Cancel we do not cancel straight away - a
  /// cancelled Shopify order can never be brought back. We wait, and if
  /// they press Confirm in the meantime nothing happens at all.
  autoCancel     Boolean @default(true)
  /// Minutes to wait before a cancellation request is acted on.
  cancelGraceMin Int     @default(30)

  /// Discount code for the second abandoned-cart reminder.
  /// If it is empty the second reminder is not sent at all - better than a fake code.
  abandonCode String?

  // --- Razorpay, for paying online inside the popup ---
  /// With both keys in, "Pay online" charges through Razorpay right there
  /// in the popup and ends on the app's own confirmation screen. Without
  /// them the popup hands over to Shopify's checkout, as it always did.
  rzpKeyId     String?
  rzpKeySecret String?

  payments Payment[]
}

/// One "Pay online" attempt: the Razorpay order it opened, and everything
/// the Shopify order will be made of. Written before the customer pays, so
/// the order can still be created if the browser never comes back - the
/// cron reads Razorpay for the money and finishes the job.
model Payment {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Razorpay's order id, order_xxx - what the checkout was opened with.
  rzpOrder   String  @unique
  rzpPayment String?
  /// In paise, exactly what Razorpay was told to collect.
  amount     Int
  /// The order's makings, as JSON: items, address, phone, discount.
  input      String
  /// pending -> creating -> ordered. "failed" when Shopify refused the
  /// order after the money came in; the cron tries again.
  status     String  @default("pending")
  orderName  String?
  orderId    String?
  error      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, createdAt])
  @@index([status, updatedAt])
}


/// Our own copy of every order, so we never have to ask Shopify again.
model OrderRecord {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  shopifyId   String
  orderNumber String
  customerName String?
  phone        String?
  email        String?
  totalPrice   String?
  currency     String?
  financial    String?
  gateway      String?

  /// COD or prepaid. Needed as a guard on orders/paid - a COD order also
  /// fires paid, but only when the courier deposits the cash.
  isCod        Boolean   @default(false)
  /// null = not asked yet, true = confirmed, false = declined
  codConfirmed Boolean?
  cancelledAt  DateTime?
  /// Set when the customer presses Cancel on WhatsApp. Cleared the moment
  /// they press Confirm instead. The cron acts on it once the grace period
  /// set on the shop has passed.
  cancelRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipments Shipment[]
  messages  MessageLog[]
  inbound   InboundMessage[]

  @@unique([shopId, shopifyId])
  @@index([shopId, createdAt])

  /// What is still to be collected on delivery. On a partial-payment COD
  /// order this is less than the total, and it is the figure the customer
  /// must be shown - never the total.
  outstanding String?

  /// "Portable Blender + 1 more item" - when a courier update arrives we do
  /// not have Shopify's payload, so we keep it here.
  itemLine String?
  city    String?
  address String?

  /// Handle of the first real product on the order - "wireless-massage-gun".
  /// The review request's button needs it, and by the time that goes out
  /// Shopify's payload is long gone.
  handle  String?

  /// Why we cancelled it - "paid_online" when the customer paid for the
  /// same items through the Pay Now link, "customer" from WhatsApp. Null
  /// when the merchant cancelled it in Shopify. paid_online sends no
  /// cancellation message: the customer just paid, nothing was cancelled
  /// from where they stand.
  cancelReason String?
  /// The corrected address or number the customer sent on WhatsApp, kept
  /// here until the merchant has passed it on to the courier.
  changeNote   String?
}


/// One order can have several parcels. Each parcel gets its own row.
model Shipment {
  id      String      @id @default(cuid())
  orderId String
  order   OrderRecord @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fulfillmentId String
  trackingNo    String?
  carrier       String?
  /// 17TRACK courier code
  carrierCode   String?
  trackUrl      String?

  /// pending | info_received | in_transit | out_for_delivery
  /// | delivered | exception | returned
  status      String    @default("pending")
  lastEventAt DateTime?

  /// whether it has been registered with the tracking API
  registered Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, fulfillmentId])
  @@index([trackingNo])

  /// 17TRACK sub_status - e.g. "DeliveryFailure_NoBody"
  subStatus     String?
  lastEventDesc String?
  lastEventLoc  String?
  /// The whole journey as JSON - the tracking page is built from this
  scans         String?
  /// How many registration attempts have been made. We give up after 5.
  regTries      Int     @default(0)
}


/// Every message we send. unique([orderId, event, channel]) is the one thing
/// that stops the same customer getting "your order has shipped" twice.
model MessageLog {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  orderId String?
  order   OrderRecord? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// whatsapp | sms
  channel String
  /// order_created | cod_confirm | order_paid | shipped
  /// | out_for_delivery | delivered | cancelled | abandoned_1 | abandoned_2
  event String
  to    String
  body  String

  /// queued | sent | failed
  status     String  @default("queued")
  providerId String?
  error      String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([orderId, event, channel])
  @@index([shopId, createdAt])
  @@index([status])
}


/// Where the merchant edits the text of their own messages.
model Template {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  event   String
  channel String
  enabled Boolean @default(true)
  body    String

  updatedAt DateTime @updatedAt

  @@unique([shopId, event, channel])
}


/// Abandoned cart. checkouts/update fires 10-15 times for one shopper, so we
/// upsert on the token and keep pushing lastSeenAt forward.
/// The moment an order arrives we fill convertedAt - then no reminder goes out.
model AbandonedCart {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  token      String
  phone      String?
  name       String?
  recoverUrl String?
  total      String?
  currency   String?
  itemCount  Int     @default(0)
  /// "Portable Blender + 1 more item" - the same line the order messages
  /// use. Without it the reminder could only say "your item", because a
  /// cart row held a count and no names at all.
  itemLine   String?
  /// "44445555:1,66667777:2" - the variant id and quantity of every line.
  /// Shopify leaves abandoned_checkout_url empty on some checkouts, and
  /// without these the reminder link had nowhere to go but the shop front.
  cartItems  String?

  lastSeenAt  DateTime  @default(now())
  reminder1At DateTime?
  reminder2At DateTime?
  convertedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([shopId, token])
  @@index([shopId, lastSeenAt])
}


/// Shopify sends the same webhook two or three times (retries, network
/// glitches). Each delivery carries a unique id - remembering it is the
/// cheapest way to make every handler idempotent.
model WebhookEvent {
  id         String   @id
  topic      String
  shop       String
  receivedAt DateTime @default(now())

  @@index([shop, topic])
}

// ============================================================================
//  Phase 2 - two changes
//
//  1. A WABA ID field on Shop (to read the template list)
//  2. An OptOut table (to honour STOP)
//
//  The script adds both - nothing to do by hand.
// ============================================================================

/// Anyone who replies STOP lands here. Checked before every send.
/// The promise in the footer is only true if we honour it.
model OptOut {
  id     String @id @default(cuid())
  shopId String
  phone  String

  createdAt DateTime @default(now())

  @@unique([shopId, phone])
  @@index([shopId])
}


/// Every reply a customer sends. This is the merchant's inbox: a number on
/// the WhatsApp Cloud API cannot be opened in the ordinary WhatsApp
/// Business app, so what is stored here is the only record there is.
///
/// waMessageId is unique because Meta retries a webhook it thinks failed.
/// Without it one "Cancel" could be acted on three times.
model InboundMessage {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  orderId String?
  order   OrderRecord? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  /// Meta's own message id
  waMessageId String @unique
  from        String
  text        String
  /// text | button | interactive | image | ...
  kind        String
  /// confirm | cancel | stop | start | address | phone | help | track
  /// | address_given | phone_given | help_given | none
  intent      String @default("none")

  createdAt DateTime @default(now())

  @@index([shopId, createdAt])

  /// What the app answered, if anything.
  reply     String?
  /// Whether the merchant was told about it on their own WhatsApp.
  forwarded Boolean @default(false)
}


/// One-time codes sent over WhatsApp to prove a phone number is real.
///
/// The code itself is never written down - only a hash of it, mixed with
/// the shop and the phone number, so one stolen row is worth nothing.
model OtpCode {
  id     String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  phone    String
  codeHash String
  /// "self" when we made the code, "mc" when Message Central holds it.
  provider String @default("self")
  /// Message Central's verificationId. Null on every self-made code.
  ref      String?
  /// Wrong guesses. Past five, the code is dead.
  attempts Int    @default(0)

  sentAt     DateTime  @default(now())
  expiresAt  DateTime
  verifiedAt DateTime?

  @@index([shopId, phone])
  @@index([expiresAt])
}


/// Someone who asked to be told when a sold-out item is back.
/// One row per number per variant; notifiedAt is set once the message goes,
/// so nobody is told twice about the same thing.
model StockAlert {
  id     String @id @default(cuid())
  shopId String

  phone     String
  variantId String
  handle    String
  title     String
  price     String?

  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([shopId, phone, variantId])
  @@index([shopId, variantId])
}
